{
  "name": "runway-cloudflare-ci-benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --containers-rollout=none",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types --check --include-runtime false --strict-vars false --env-interface CloudflareBindings && tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/ci": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/node": "^24.12.0",
    "typescript": "6.0.3",
    "wrangler": "4.118.0"
  }
}
