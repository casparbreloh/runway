{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runway-cloudflare-ci-benchmark",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "runway-benchmark",
    },
  ],
  "containers": [
    {
      "class_name": "CiSandbox",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "standard-4",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox",
      },
    ],
  },
  "workflows": [
    {
      "name": "runway-cloudflare-ci-benchmark",
      "binding": "CI_WORKFLOW",
      "class_name": "CI",
    },
  ],
  "exports": {
    "CiSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "runway-cloudflare-ci-backups",
    },
  ],
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": {
          "namespace": "runway-benchmark",
          "repo_name": "runway",
        },
        "targets": [
          {
            "type": "workflow",
            "workflow_name": "runway-cloudflare-ci-benchmark",
          },
        ],
      },
    ],
  },
  "vars": {
    "BACKUP_BUCKET_NAME": "runway-cloudflare-ci-backups",
    "CLOUDFLARE_ACCOUNT_ID": "set-at-deploy",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
  },
}
