{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@runway/core": ["./packages/core/src/index.ts"],
      "@runway/cloudflare": ["./packages/cloudflare/src/index.ts"],
      "@runway/cloudflare/worker": ["./packages/cloudflare/src/worker.ts"]
    }
  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/cloudflare" },
    { "path": "example" }
  ]
}
