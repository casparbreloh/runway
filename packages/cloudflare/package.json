{
  "name": "@runway/cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare backend for Runway coding automation workflows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casparbreloh/runway.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./worker": {
      "workerd": {
        "types": "./dist/worker.d.mts",
        "default": "./dist/worker.mjs"
      },
      "worker": {
        "types": "./dist/worker.d.mts",
        "default": "./dist/worker.mjs"
      },
      "import": {
        "types": "./dist/worker.d.mts",
        "default": "./dist/worker.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/worker.ts --dts --clean --deps.never-bundle cloudflare:workers --deps.never-bundle @runway/core --tsconfig tsconfig.build.json --logLevel error"
  },
  "dependencies": {
    "@runway/core": "workspace:*",
    "cloudflare": "catalog:",
    "esbuild": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:"
  }
}
