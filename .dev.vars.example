# Copy to .dev.vars for `wrangler dev`, or set as `wrangler secret put <NAME>` for production.
# These are SECRETS — never commit .dev.vars.

# Linear webhook signing secret (Linear → Settings → API → Webhooks).
LINEAR_WEBHOOK_SECRET=

# Bearer token required to call POST /jobs (the direct/dev submit path).
# Unset on a deployed instance => the endpoint is disabled (fail closed).
RUNWAY_API_TOKEN=

# GitHub token (fine-grained PAT: Pull requests: write, Contents: read, Metadata: read).
GITHUB_TOKEN=

# Pi (one of these, depending on the model pi targets).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Codex Cloud: a ChatGPT/Codex backend access token (NOT a bare API key).
CODEX_ACCESS_TOKEN=

# --- non-secret config (also settable in wrangler.jsonc "vars") ---
# DEFAULT_REPO=owner/name
# GITHUB_OWNER=owner
# CODEX_CLOUD_ENV_ID=
