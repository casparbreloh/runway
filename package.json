{
  "name": "runway-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "fallow": "fallow --ci --no-cache",
    "lint": "oxlint",
    "legacy:capture": "node packages/runway/tests/live-legacy-stack.ts --capture",
    "legacy:dry-run": "node packages/runway/tests/live-legacy-stack.ts --dry-run",
    "test": "vitest run",
    "test:live": "node packages/runway/tests/live-cache-transfer-smoke.ts && node packages/runway/tests/live-workflow-artifact-smoke.ts && node packages/runway/tests/live-repository-recovery-smoke.ts && node packages/runway/tests/live-github-recovery-smoke.ts",
    "typecheck": "tsgo --build"
  },
  "dependencies": {
    "runway": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "fallow": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.0"
    },
    "runtime": {
      "name": "node",
      "version": "^26"
    }
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@11.5.0",
  "runway": {
    "name": "runway"
  }
}
