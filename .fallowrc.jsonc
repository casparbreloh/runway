{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    ".runway/workflows/**/*.ts",
    "packages/runway/src/internal/runtime/host.ts",
    "packages/runway/vitest*.config.ts",
    "packages/runway/tests/**/*.test.ts",
    "packages/runway/tests/live/*.live.ts",
    "packages/runway/tests/support/*-worker.ts",
  ],
  "ignoreDependencies": ["@cloudflare/dynamic-workflows"],
  "usedClassMembers": [
    {
      "extends": "DurableObject",
      "members": [
        "admit",
        "lifecycle",
        "claimTerminal",
        "readTerminal",
        "current",
        "publishTerminal",
        "alarm",
      ],
    },
    { "implements": "StackControl", "members": ["urls"] },
  ],
  "duplicates": {
    "minTokens": 80,
    "minLines": 8,
    "threshold": 0.01,
  },
  "rules": {
    "require-suppression-reason": "error",
    "stale-suppressions": "error",
  },
}
